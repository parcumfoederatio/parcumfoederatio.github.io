rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function connecte() { return request.auth != null; }
    function moi() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function existe() { return connecte() && exists(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function estConsul() { return existe() && moi().role == 'consul'; }
    function estChef() { return estConsul() && moi().get('chef', false) == true; }
    function seulement(champs) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(champs); }
    function change(champs) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(champs); }
    function texte(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function provinces() { return ['Saint-Paul-de-la-Croix','Ahuntsic','Sauvé','Fleury','Guzzo','Desjardins','Gouin','Toilettes mixtes du CVM']; }
    function senateurVotant() { return existe() && moi().get('senat', null) in provinces(); }
    function senateur() { return existe() && moi().get('senat', null) != null; }

    match /users/{uid} {
      allow read: if connecte();
      allow create: if connecte() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pseudo','prenom','nom','role','citoyenNo','couleur','sparcs','creeLe','derniereTx'])
        && texte(request.resource.data.pseudo, 2, 30)
        && texte(request.resource.data.prenom, 1, 40)
        && texte(request.resource.data.nom, 1, 40)
        && request.resource.data.role == 'visiteur'
        && request.resource.data.citoyenNo == null
        && request.resource.data.couleur == null
        && request.resource.data.sparcs == 0
        && request.resource.data.derniereTx == null
        && request.resource.data.creeLe == request.time;
      allow update: if estConsul()
        && !change(['chef'])
        && (!change(['prenom','nom','senat','juge']) || estChef())
        && (!change(['role'])
            || estChef()
            || (resource.data.role in ['visiteur','resident'] && request.resource.data.role == 'citoyen'
                && getAfter(/databases/$(db)/documents/demandes/$(uid)).data.statut == 'acceptee'
                && getAfter(/databases/$(db)/documents/demandes/$(uid)).data.signatures.size() >= 5));
      allow update: if connecte() && request.auth.uid == uid && seulement(['pseudo'])
        && texte(request.resource.data.pseudo, 2, 30);
      allow update: if connecte() && request.auth.uid == uid && seulement(['sparcs','derniereTx'])
        && txValide(request.resource.data.derniereTx, uid, true);
      allow update: if connecte() && request.auth.uid != uid && seulement(['sparcs','derniereTx'])
        && txValide(request.resource.data.derniereTx, uid, false);
    }

    function txValide(txId, uid, payeur) {
      let chemin = /databases/$(db)/documents/transactions/$(txId);
      let tx = getAfter(chemin).data;
      return txId is string && !exists(chemin) && existsAfter(chemin)
        && tx.de == request.auth.uid
        && (payeur
              ? (tx.de == uid && request.resource.data.sparcs == resource.data.sparcs - tx.montant)
              : (tx.a == uid && request.resource.data.sparcs == resource.data.sparcs + tx.montant));
    }

    match /transactions/{txId} {
      allow read: if connecte() && (resource.data.de == request.auth.uid || resource.data.a == request.auth.uid || estConsul());
      allow create: if connecte()
        && request.resource.data.keys().hasOnly(['de','a','montant','date','deP','aP','motif'])
        && request.resource.data.de == request.auth.uid
        && request.resource.data.a != request.auth.uid
        && request.resource.data.montant is int && request.resource.data.montant > 0
        && request.resource.data.date == request.time
        && moi().role == 'citoyen'
        && get(/databases/$(db)/documents/users/$(request.resource.data.a)).data.role == 'citoyen'
        && getAfter(/databases/$(db)/documents/users/$(request.auth.uid)).data.derniereTx == txId
        && getAfter(/databases/$(db)/documents/users/$(request.resource.data.a)).data.derniereTx == txId
        && getAfter(/databases/$(db)/documents/users/$(request.auth.uid)).data.sparcs >= 0;
      // Achat à la boutique d'État : les Sparcs retournent à l'État
      allow create: if connecte()
        && request.resource.data.keys().hasOnly(['de','a','montant','date','deP','aP','motif','commande'])
        && request.resource.data.de == request.auth.uid
        && request.resource.data.a == 'etat'
        && request.resource.data.montant is int && request.resource.data.montant > 0
        && request.resource.data.date == request.time
        && moi().role == 'citoyen'
        && getAfter(/databases/$(db)/documents/users/$(request.auth.uid)).data.derniereTx == txId
        && getAfter(/databases/$(db)/documents/users/$(request.auth.uid)).data.sparcs >= 0
        && getAfter(/databases/$(db)/documents/commandes/$(request.resource.data.commande)).data.txId == txId
        && getAfter(/databases/$(db)/documents/commandes/$(request.resource.data.commande)).data.total == request.resource.data.montant;
      allow create: if estConsul()
        && request.resource.data.de == 'etat'
        && request.resource.data.montant is int && request.resource.data.montant != 0
        && request.resource.data.date == request.time;
    }

    match /demandes/{uid} {
      allow read: if connecte() && (request.auth.uid == uid || estConsul());
      allow create: if connecte() && request.auth.uid == uid
        && moi().role in ['visiteur','resident']
        && request.resource.data.keys().hasOnly(['nomComplet','pseudo','dateArrivee','temoin','allegeance','statut','signatures','veto','creeLe'])
        && request.resource.data.allegeance == true
        && request.resource.data.statut == 'en attente'
        && request.resource.data.signatures.size() == 0
        && request.resource.data.veto == null
        && request.resource.data.nomComplet is string && request.resource.data.nomComplet.size() <= 80
        && request.resource.data.temoin is string && request.resource.data.temoin.size() <= 80
        && request.resource.data.creeLe == request.time;
      allow update: if estConsul();
      allow delete: if connecte() && ((request.auth.uid == uid && resource.data.statut != 'acceptee') || estConsul());
    }

    match /brouillons/{id} {
      allow read: if estConsul();
      allow create: if estConsul() && request.resource.data.auteur == request.auth.uid;
      allow update: if estConsul() && (
        resource.data.auteur == request.auth.uid
        || (seulement(['votes']) && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([request.auth.uid]))
      );
      allow update: if estChef();
      allow delete: if estConsul() && resource.data.auteur == request.auth.uid;
    }

    match /photos/{uid} {
      allow read: if connecte() && (request.auth.uid == uid || estConsul());
      allow create, update: if connecte() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['img','majLe'])
        && request.resource.data.img is string
        && request.resource.data.img.size() < 300000
        && request.resource.data.img.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.majLe == request.time;
      allow delete: if connecte() && (request.auth.uid == uid || estConsul());
    }

    // ---------- Sénat ----------
    match /senat/presidence {
      allow read: if connecte();
      allow create: if senateurVotant()
        && request.resource.data.keys().hasOnly(['votes'])
        && request.resource.data.votes.keys().hasOnly([request.auth.uid]);
      allow update: if senateurVotant() && seulement(['votes'])
        && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([request.auth.uid]);
    }

    match /lois/{id} {
      allow read: if connecte();
      allow create: if connecte()
        && request.resource.data.keys().hasOnly(['type','province','titre','contenu','statut','auteur','auteurP','creeLe','votesSenat','votesConseil'])
        && request.resource.data.auteur == request.auth.uid
        && texte(request.resource.data.titre, 1, 120)
        && texte(request.resource.data.contenu, 1, 8000)
        && request.resource.data.creeLe == request.time
        && request.resource.data.votesSenat.size() == 0
        && request.resource.data.votesConseil.size() == 0
        && ((request.resource.data.type == 'loi' && (senateurVotant() || estChef())
              && request.resource.data.statut == 'senat' && request.resource.data.province == null)
          || (request.resource.data.type == 'acte' && request.resource.data.statut == 'en vigueur'
              && ((senateur() && request.resource.data.province == moi().senat)
                  || (estChef() && request.resource.data.province in provinces().concat(['Place Fairfield'])))));
      // Vote des sénateurs, tant que la loi est au Sénat
      allow update: if senateurVotant()
        && resource.data.type == 'loi' && resource.data.statut == 'senat'
        && seulement(['votesSenat','statut'])
        && request.resource.data.votesSenat.diff(resource.data.votesSenat).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.votesSenat[request.auth.uid] in ['pour','contre']
        && request.resource.data.statut in ['senat','conseil','rejetee'];
      // Conseil du MMT : vote, modifie le texte, annule les actes provinciaux
      allow update: if estConsul()
        && !change(['auteur','auteurP','type','province','creeLe','votesSenat'])
        && request.resource.data.votesConseil.diff(resource.data.votesConseil).affectedKeys().hasOnly([request.auth.uid])
        && ((resource.data.type == 'loi' && resource.data.statut == 'conseil'
              && request.resource.data.statut in ['conseil','adoptee','rejetee'])
          || (resource.data.type == 'acte' && resource.data.statut == 'en vigueur'
              && seulement(['statut']) && request.resource.data.statut == 'annule'));
      // Consul fondateur : accès complet
      allow update: if estChef() && !change(['auteur','creeLe','type']);
      allow delete: if connecte() && (estChef() || (resource.data.auteur == request.auth.uid
        && (resource.data.statut == 'senat' || resource.data.type == 'acte')));
    }

    // ---------- Cour suprême ----------
    match /affaires/{id} {
      allow read: if connecte();
      allow create: if existe() && (moi().role in ['citoyen','consul','resident'] || estChef())
        && request.resource.data.keys().hasOnly(['numero','type','titre','demandeur','demandeurP','defendeur','defendeurP','faits','demande','textes','statut','creeLe','reponse','jugement','verdict','sanction','juge','jugeP','jugeLe'])
        && request.resource.data.demandeur == request.auth.uid
        && request.resource.data.type in ['plainte','doleance']
        && request.resource.data.numero is int
        && texte(request.resource.data.titre, 1, 120)
        && texte(request.resource.data.faits, 1, 8000)
        && texte(request.resource.data.demande, 1, 3000)
        && texte(request.resource.data.textes, 0, 200)
        && request.resource.data.statut == 'deposee'
        && request.resource.data.creeLe == request.time
        && request.resource.data.reponse == null && request.resource.data.jugement == null
        && request.resource.data.verdict == null && request.resource.data.sanction == null
        && request.resource.data.juge == null;
      // Le défendeur répond, tant que l'affaire n'est pas jugée
      allow update: if connecte() && resource.data.defendeur == request.auth.uid
        && resource.data.statut in ['deposee','en cours'] && seulement(['reponse'])
        && texte(request.resource.data.reponse, 1, 8000);
      // Le demandeur retire son affaire
      allow update: if connecte() && resource.data.demandeur == request.auth.uid
        && resource.data.statut in ['deposee','en cours'] && seulement(['statut'])
        && request.resource.data.statut == 'retiree';
      // Un juge suppléant juge, s'il n'est pas partie à l'affaire
      allow update: if existe() && moi().get('juge', false) == true
        && resource.data.demandeur != request.auth.uid && resource.data.defendeur != request.auth.uid
        && !change(['numero','type','demandeur','demandeurP','defendeur','defendeurP','faits','demande','textes','creeLe','reponse'])
        && request.resource.data.statut in ['deposee','en cours','jugee','irrecevable'];
      // Consul fondateur (juge en chef) : accès complet
      allow update: if estChef() && !change(['creeLe']);
      allow delete: if estChef();
    }

    // ---------- Boutique d'État ----------
    function imageValide(v) { return v == null || (v is string && v.size() < 300000 && v.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')); }
    function produitDe(pid) { return get(/databases/$(db)/documents/produits/$(pid)).data; }
    function commandeApres(cid) { return getAfter(/databases/$(db)/documents/commandes/$(cid)).data; }

    match /produits/{id} {
      allow read: if true;
      allow create: if estConsul()
        && request.resource.data.keys().hasOnly(['nom','description','icone','img','prix','stock','actif','creeLe','derniereCommande'])
        && imageValide(request.resource.data.get('img', null))
        && texte(request.resource.data.nom, 1, 60)
        && texte(request.resource.data.description, 0, 500)
        && texte(request.resource.data.icone, 0, 8)
        && request.resource.data.prix is int && request.resource.data.prix > 0
        && (request.resource.data.stock == null || (request.resource.data.stock is int && request.resource.data.stock >= 0))
        && request.resource.data.actif is bool
        && request.resource.data.creeLe == request.time;
      allow update: if estConsul() && !change(['creeLe'])
        && imageValide(request.resource.data.get('img', null))
        && request.resource.data.prix is int && request.resource.data.prix > 0
        && (request.resource.data.stock == null || (request.resource.data.stock is int && request.resource.data.stock >= 0));
      // Un citoyen qui achète fait baisser le stock du nombre acheté
      allow update: if connecte() && seulement(['stock','derniereCommande'])
        && resource.data.stock is int
        && !exists(/databases/$(db)/documents/commandes/$(request.resource.data.derniereCommande))
        && commandeApres(request.resource.data.derniereCommande).acheteur == request.auth.uid
        && commandeApres(request.resource.data.derniereCommande).produit == id
        && request.resource.data.stock == resource.data.stock - commandeApres(request.resource.data.derniereCommande).quantite
        && request.resource.data.stock >= 0;
      allow delete: if estConsul();
    }

    match /commandes/{cid} {
      allow read: if connecte() && (resource.data.acheteur == request.auth.uid || estConsul());
      allow create: if connecte() && moi().role == 'citoyen'
        && request.resource.data.keys().hasOnly(['acheteur','acheteurP','produit','produitNom','prix','quantite','total','statut','date','txId'])
        && request.resource.data.acheteur == request.auth.uid
        && request.resource.data.statut == 'payee'
        && request.resource.data.date == request.time
        && request.resource.data.quantite is int && request.resource.data.quantite >= 1 && request.resource.data.quantite <= 10
        && produitDe(request.resource.data.produit).actif == true
        && request.resource.data.prix == produitDe(request.resource.data.produit).prix
        && request.resource.data.total == request.resource.data.prix * request.resource.data.quantite
        && getAfter(/databases/$(db)/documents/transactions/$(request.resource.data.txId)).data.de == request.auth.uid
        && getAfter(/databases/$(db)/documents/transactions/$(request.resource.data.txId)).data.montant == request.resource.data.total
        && (produitDe(request.resource.data.produit).get('stock', null) == null
            || getAfter(/databases/$(db)/documents/produits/$(request.resource.data.produit)).data.derniereCommande == cid);
      allow update: if estConsul() && seulement(['statut','rembourseTx'])
        && request.resource.data.statut in ['payee','livree','annulee'];
      allow delete: if estChef();
    }

    // ---------- Cartes vérifiables (QR code) ----------
    function carteConforme(uid) {
      let u = get(/databases/$(db)/documents/users/$(uid)).data;
      let c = request.resource.data;
      return c.keys().hasOnly(['prenom','nom','pseudo','citoyenNo','role','couleur','senat','juge','chef','maj'])
        && c.prenom == u.get('prenom', null) && c.nom == u.get('nom', null) && c.pseudo == u.get('pseudo', null)
        && c.citoyenNo == u.get('citoyenNo', null) && c.role == u.role && c.couleur == u.get('couleur', null)
        && c.senat == u.get('senat', null)
        && c.juge == (u.get('juge', false) == true) && c.chef == (u.get('chef', false) == true)
        && c.maj == request.time;
    }

    match /cartes/{uid} {
      allow get: if true;
      allow list: if estConsul();
      allow create, update: if connecte() && carteConforme(uid);
      allow delete: if estChef();
    }

    // ---------- Journal du MMT ----------
    function membre() { return existe() && moi().role in ['citoyen','resident','consul']; }
    function mmtValide() {
      let m = request.resource.data;
      return m.keys().hasOnly(['saison','titre','date','endroit','membres','invites','reel','rating','note','creeLe'])
        && m.saison in ['Saison 1','Saison 2','Saison 3','Saison 4','Hors Série']
        && texte(m.titre, 1, 60)
        && m.date is string && m.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && texte(m.endroit, 0, 160)
        && m.membres is list && m.membres.size() <= 5
        && m.invites is list && m.invites.size() <= 30
        && (m.reel == null || m.reel is int)
        && (m.rating == null || m.rating is number)
        && texte(m.note, 0, 2000);
    }

    match /mmt/{id} {
      allow read: if membre();
      allow create: if estConsul() && mmtValide() && request.resource.data.creeLe == request.time;
      allow update: if estConsul() && mmtValide() && !change(['creeLe']);
      allow delete: if estConsul();
    }

    // ---------- Journal officiel (publié par le Consul fondateur) ----------
    match /journal/{id} {
      allow read: if true;
      allow create: if estChef()
        && request.resource.data.keys().hasOnly(['type','numero','titre','contenu','source','sourceId','publieLe'])
        && request.resource.data.type in ['decret','loi']
        && texte(request.resource.data.numero, 1, 20)
        && texte(request.resource.data.titre, 1, 160)
        && texte(request.resource.data.contenu, 1, 20000)
        && request.resource.data.publieLe == request.time;
      allow update: if estChef() && !change(['publieLe']);
      allow delete: if estChef();
    }
  }
}
